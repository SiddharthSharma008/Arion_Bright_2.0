# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Model selection
ARION_MODEL=claude-sonnet-4-5

# Optional: Langfuse observability (free tier at cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Vector store location
CHROMA_PERSIST_DIR=./data/chroma

# Server
API_HOST=127.0.0.1
API_PORT=8000
